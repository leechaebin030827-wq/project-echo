      "durationMs": 3500
    },
    "FI-O14": {
      "id": "FI-O14",
      "language": "fi",
      "text": "Tadaa! Tervetuloa Haminaan, Suomeen!",
      "scene": "하미나 / Finland",
      "src": "/audio/echo/fi/FI-O14.mp3",
      "durationMs": 2168
    },
    "FI-O15": {
      "id": "FI-O15",
      "language": "fi",
      "text": "Meren rannalla on suuri datakeskus.",
      "scene": "하미나 / Finland",
      "src": "/audio/echo/fi/FI-O15.mp3",
      "durationMs": 2220
    },
    "FI-O16": {
      "id": "FI-O16",
      "language": "fi",
      "text": "Tämä oli ennen paperitehdas.",
      "scene": "하미나 / Finland",
      "src": "/audio/echo/fi/FI-O16.mp3",
      "durationMs": 1750
    },
    "FI-O17": {
      "id": "FI-O17",
      "language": "fi",
      "text": "Nyt täällä käsitellään paperin sijaan dataa.",
      "scene": "하미나 / Finland",
      "src": "/audio/echo/fi/FI-O17.mp3",
      "durationMs": 2482
    },
    "FI-O18": {
      "id": "FI-O18",
      "language": "fi",
      "text": "Taitellaan paperista pilvi.",
      "scene": "하미나 / Finland",
