      "durationMs": 1776
    },
    "FI-O22": {
      "id": "FI-O22",
      "language": "fi",
      "text": "lämmittää lähiseudun asukkaiden koteja.",
      "scene": "하미나 / Ocean",
      "src": "/audio/echo/fi/FI-O22.mp3",
      "durationMs": 2482
    },
    "FI-O23": {
      "id": "FI-O23",
      "language": "fi",
      "text": "Hys! Älä kerro tätä metsälle.",
      "scene": "하미나 / Forest",
      "src": "/audio/echo/fi/FI-O23.mp3",
      "durationMs": 2351
    },
    "FI-O24": {
      "id": "FI-O24",
      "language": "fi",
      "text": "He ovat kuulemma ostaneet lisää maata täältä!",
      "scene": "하미나 / Forest",
