      "id": "FI-O05",
      "language": "fi",
      "text": "Suhinaa! Suhinaa!",
      "scene": "하미나 / Cooler",
      "src": "/audio/echo/fi/FI-O05.mp3",
      "durationMs": 2038
    },
    "FI-O06": {
      "id": "FI-O06",
      "language": "fi",
      "text": "Koneet tekevät kovasti töitä poistaakseen lämpöä.",
      "scene": "하미나 / Cooler",
      "src": "/audio/echo/fi/FI-O06.mp3",
      "durationMs": 2952
    },
    "FI-O07": {
      "id": "FI-O07",
      "language": "fi",
      "text": "Voi, muistomme ovat kylmiä.",
      "scene": "하미나 / Cooler",
      "src": "/audio/echo/fi/FI-O07.mp3",
      "durationMs": 1411
    },
    "FI-O08": {
      "id": "FI-O08",
      "language": "fi",
      "text": "Tik tak! Tik tak!",
      "scene": "하미나 / Timer",
      "src": "/audio/echo/fi/FI-O08.mp3",
      "durationMs": 1620
    },
    "FI-O09": {
      "id": "FI-O09",
      "language": "fi",
      "text": "He ovat sopineet ostavansa tänne sähköä peräti",
      "scene": "하미나 / Timer",
      "src": "/audio/echo/fi/FI-O09.mp3",
      "durationMs": 3265
    },
    "FI-O10": {
      "id": "FI-O10",
      "language": "fi",
      "text": "22 vuoden ajan!",
      "scene": "하미나 / Timer",
      "src": "/audio/echo/fi/FI-O10.mp3",
      "durationMs": 1881
    },
    "FI-O11": {
      "id": "FI-O11",
      "language": "fi",
      "text": "Voimalaitos valmistautuu",
      "scene": "하미나 / Timer",
      "src": "/audio/echo/fi/FI-O11.mp3",
      "durationMs": 1123
    },
    "FI-O12": {
      "id": "FI-O12",
      "language": "fi",
      "text": "jatkamaan töitä vuoteen 2050 asti.",
      "scene": "하미나 / Timer",
      "src": "/audio/echo/fi/FI-O12.mp3",
      "durationMs": 3056
    },
    "FI-O13": {
      "id": "FI-O13",
      "language": "fi",
      "text": "Kuinka vanha sinun valokuvasi silloin on?",
      "scene": "하미나 / Timer",
      "src": "/audio/echo/fi/FI-O13.mp3",
      "durationMs": 3500
    },
    "FI-O14": {
      "id": "FI-O14",
      "language": "fi",
      "text": "Tadaa! Tervetuloa Haminaan, Suomeen!",
      "scene": "하미나 / Finland",
      "src": "/audio/echo/fi/FI-O14.mp3",
      "durationMs": 2168
    },
    "FI-O15": {
      "id": "FI-O15",
      "language": "fi",
      "text": "Meren rannalla on suuri datakeskus.",
      "scene": "하미나 / Finland",
      "src": "/audio/echo/fi/FI-O15.mp3",
      "durationMs": 2220
    },
    "FI-O16": {
      "id": "FI-O16",
      "language": "fi",
      "text": "Tämä oli ennen paperitehdas.",
      "scene": "하미나 / Finland",
      "src": "/audio/echo/fi/FI-O16.mp3",
      "durationMs": 1750
    },
    "FI-O17": {
      "id": "FI-O17",
      "language": "fi",
      "text": "Nyt täällä käsitellään paperin sijaan dataa.",
      "scene": "하미나 / Finland",
      "src": "/audio/echo/fi/FI-O17.mp3",
      "durationMs": 2482
    },
    "FI-O18": {
      "id": "FI-O18",
      "language": "fi",
      "text": "Taitellaan paperista pilvi.",
      "scene": "하미나 / Finland",
      "src": "/audio/echo/fi/FI-O18.mp3",
      "durationMs": 1646
    },
    "FI-O19": {
      "id": "FI-O19",
      "language": "fi",
      "text": "Loiskis!",
      "scene": "하미나 / Ocean",
      "src": "/audio/echo/fi/FI-O19.mp3",
      "durationMs": 784
    },
    "FI-O20": {
      "id": "FI-O20",
      "language": "fi",
      "text": "Tämä merivesi kuulemma jäähdyttää koneita!",
      "scene": "하미나 / Ocean",
      "src": "/audio/echo/fi/FI-O20.mp3",
      "durationMs": 2717
    },
    "FI-O21": {
      "id": "FI-O21",
      "language": "fi",
      "text": "Mutta koneiden tuottama lämpö",
      "scene": "하미나 / Ocean",
      "src": "/audio/echo/fi/FI-O21.mp3",
      "durationMs": 1776
    },
    "FI-O22": {
      "id": "FI-O22",
      "language": "fi",
      "text": "lämmittää lähiseudun asukkaiden koteja.",
      "scene": "하미나 / Ocean",
      "src": "/audio/echo/fi/FI-O22.mp3",
      "durationMs": 2482
    },
    "FI-O23": {
      "id": "FI-O23",
      "language": "fi",
      "text": "Hys! Älä kerro tätä metsälle.",
      "scene": "하미나 / Forest",
      "src": "/audio/echo/fi/FI-O23.mp3",
      "durationMs": 2351
    },
    "FI-O24": {
      "id": "FI-O24",
      "language": "fi",
      "text": "He ovat kuulemma ostaneet lisää maata täältä!",
      "scene": "하미나 / Forest",
      "src": "/audio/echo/fi/FI-O24.mp3",
      "durationMs": 2508
    },
    "FI-O25": {
      "id": "FI-O25",
      "language": "fi",
      "text": "Pilveä aiotaan kai kasvattaa suuremmaksi.",
      "scene": "하미나 / Forest",
      "src": "/audio/echo/fi/FI-O25.mp3",
      "durationMs": 2586
    },
    "FI-O26": {
      "id": "FI-O26",
      "language": "fi",
      "text": "Mutta puut eivät taida vielä tietää siitä…",
      "scene": "하미나 / Forest",
      "src": "/audio/echo/fi/FI-O26.mp3",
      "durationMs": 2534
    },
    "FI-O27": {
      "id": "FI-O27",
      "language": "fi",
      "text": "Entä jos niiden täytyy muuttaa?",
      "scene": "하미나 / Forest",
      "src": "/audio/echo/fi/FI-O27.mp3",
      "durationMs": 1959
    },
    "FI-O28": {
      "id": "FI-O28",
      "language": "fi",
      "text": "Ai niin, eiväthän puut osaa kävellä!",
      "scene": "하미나 / Forest",
      "src": "/audio/echo/fi/FI-O28.mp3",
      "durationMs": 2691
    },
    "JP-O01": {
      "id": "JP-O01",
      "language": "ja",
      "text": "ここはもともと、土砂が通っていた道なんです！",
      "scene": "고베 / Tunnel Archive 01",
      "src": "/audio/echo/ja/JP-O01.mp3",
      "durationMs": 3805
    },
    "JP-O02": {
      "id": "JP-O02",
      "language": "ja",
      "text": "これからは、データのための空間になるそうです。",
      "scene": "고베 / Tunnel Archive 01",
      "src": "/audio/echo/ja/JP-O02.mp3",
      "durationMs": 4240
    },
    "JP-O03": {
      "id": "JP-O03",
      "language": "ja",
      "text": "トンネルも転職するんですね！",
      "scene": "고베 / Tunnel Archive 01",
      "src": "/audio/echo/ja/JP-O03.mp3",
      "durationMs": 2357
    },
    "JP-O04": {
      "id": "JP-O04",
      "language": "ja",
      "text": "私より働き者ですね？",
      "scene": "고베 / Tunnel Archive 01",
      "src": "/audio/echo/ja/JP-O04.mp3",
      "durationMs": 2957
    },
    "JP-O05": {
      "id": "JP-O05",
      "language": "ja",
      "text": "おお！トンネル再活用の計画書ですね。",
      "scene": "고베 / Tunnel Archive 02",
      "src": "/audio/echo/ja/JP-O05.mp3",
      "durationMs": 4707
    },
    "JP-O06": {
      "id": "JP-O06",
      "language": "ja",
      "text": "再活用というと、瓶や缶のことかと思っていましたが……",
      "scene": "고베 / Tunnel Archive 02",
      "src": "/audio/echo/ja/JP-O06.mp3",
      "durationMs": 4473
    },
    "JP-O07": {
      "id": "JP-O07",
      "language": "ja",
      "text": "トンネルも再活用するんですね！",
      "scene": "고베 / Tunnel Archive 02",
      "src": "/audio/echo/ja/JP-O07.mp3",
      "durationMs": 3706
    },
    "JP-O08": {
      "id": "JP-O08",
      "language": "ja",
      "text": "とても大きな分別回収ですね！",
      "scene": "고베 / Tunnel Archive 02",
      "src": "/audio/echo/ja/JP-O08.mp3",
      "durationMs": 3037
    },
    "JP-O09": {
      "id": "JP-O09",
      "language": "ja",
      "text": "2005年9月、土砂を運ぶ仕事は終了！",
      "scene": "고베 / Tunnel Archive 03",
      "src": "/audio/echo/ja/JP-O09.mp3",
      "durationMs": 4778
    },
    "JP-O10": {
      "id": "JP-O10",
      "language": "ja",
      "text": "40年以上も働いたそうです。",
      "scene": "고베 / Tunnel Archive 03",
      "src": "/audio/echo/ja/JP-O10.mp3",
      "durationMs": 3203
    },
    "JP-O11": {
      "id": "JP-O11",
      "language": "ja",
      "text": "やっとゆっくり休めるのかと思ったら……",
      "scene": "고베 / Tunnel Archive 03",
      "src": "/audio/echo/ja/JP-O11.mp3",
      "durationMs": 3245
    },
    "JP-O12": {
      "id": "JP-O12",
      "language": "ja",
      "text": "また出勤する予定なんですね！",
      "scene": "고베 / Tunnel Archive 03",
      "src": "/audio/echo/ja/JP-O12.mp3",
      "durationMs": 2619
    },
    "JP-O13": {
      "id": "JP-O13",
      "language": "ja",
      "text": "速報です！速報！",
      "scene": "고베 / Tunnel Archive 04",
      "src": "/audio/echo/ja/JP-O13.mp3",
      "durationMs": 1255
    },
    "JP-O14": {
      "id": "JP-O14",
      "language": "ja",
      "text": "ここにデータセンターを造ると、2026年10月6日に発表したそうです！",
      "scene": "고베 / Tunnel Archive 04",
      "src": "/audio/echo/ja/JP-O14.mp3",
      "durationMs": 8193
    },
    "JP-O15": {
      "id": "JP-O15",
      "language": "ja",
      "text": "でも、コンピューターたちはまだ出勤前みたいですね。",
      "scene": "고베 / Tunnel Archive 04",
      "src": "/audio/echo/ja/JP-O15.mp3",
      "durationMs": 5286
    },
    "JP-O16": {
      "id": "JP-O16",
      "language": "ja",
      "text": "あれ？ここは一年中、15度から20度の間だそうです！",
      "scene": "고베 / Tunnel Archive 05",
      "src": "/audio/echo/ja/JP-O16.mp3",
      "durationMs": 5203
    },
    "JP-O17": {
      "id": "JP-O17",
      "language": "ja",
      "text": "コンピューターたちが喜びそうですね。",
      "scene": "고베 / Tunnel Archive 05",
      "src": "/audio/echo/ja/JP-O17.mp3",
      "durationMs": 2870
    },
    "JP-O18": {
      "id": "JP-O18",
      "language": "ja",
      "text": "私はまず上着を用意します。",
      "scene": "고베 / Tunnel Archive 05",
      "src": "/audio/echo/ja/JP-O18.mp3",
      "durationMs": 2999
    },
    "JP-O19": {
      "id": "JP-O19",
      "language": "ja",
      "text": "ぶるぶる！",
      "scene": "고베 / Tunnel Archive 05",
      "src": "/audio/echo/ja/JP-O19.mp3",
      "durationMs": 1106
    },
    "JP-O20": {
      "id": "JP-O20",
      "language": "ja",
      "text": "2027年末にオープンする予定だそうです！",
      "scene": "고베 / Tunnel Archive 06",
      "src": "/audio/echo/ja/JP-O20.mp3",
      "durationMs": 3904
    },
    "JP-O21": {
      "id": "JP-O21",
      "language": "ja",
      "text": "どうりで誰もいないわけですね。",
      "scene": "고베 / Tunnel Archive 06",
      "src": "/audio/echo/ja/JP-O21.mp3",
      "durationMs": 2819
    },
    "JP-O22": {
      "id": "JP-O22",
      "language": "ja",
      "text": "私たち、ずいぶん早く来てしまいましたね。",
      "scene": "고베 / Tunnel Archive 06",
      "src": "/audio/echo/ja/JP-O22.mp3",
      "durationMs": 3302
    },
    "JP-O23": {
      "id": "JP-O23",
      "language": "ja",
      "text": "ほほう。待つことには自信があります！",
      "scene": "고베 / Tunnel Archive 06",
      "src": "/audio/echo/ja/JP-O23.mp3",
      "durationMs": 3623
    },
    "JP-O24": {
      "id": "JP-O24",
      "language": "ja",
      "text": "このトンネルは、14.5キロメートルもあるそうです！",
      "scene": "고베 / Tunnel Archive 07",
      "src": "/audio/echo/ja/JP-O24.mp3",
      "durationMs": 4368
    },
    "JP-O25": {
      "id": "JP-O25",
      "language": "ja",
      "text": "そのうち3キロメートルを、データセンターとして使う計画だそうです。",
      "scene": "고베 / Tunnel Archive 07",
      "src": "/audio/echo/ja/JP-O25.mp3",
      "durationMs": 6806
    },
    "JP-O26": {
      "id": "JP-O26",
      "language": "ja",
      "text": "残りは？",
      "scene": "고베 / Tunnel Archive 07",
      "src": "/audio/echo/ja/JP-O26.mp3",
      "durationMs": 1178
    },
    "JP-O27": {
      "id": "JP-O27",
      "language": "ja",
      "text": "うーん……私も気になります！",
      "scene": "고베 / Tunnel Archive 07",
      "src": "/audio/echo/ja/JP-O27.mp3",
      "durationMs": 2764
    },
    "JP-O28": {
      "id": "JP-O28",
      "language": "ja",
      "text": "あっ！工事関係者以外、立入禁止！",
      "scene": "고베 / Tunnel Archive 08",
      "src": "/audio/echo/ja/JP-O28.mp3",
      "durationMs": 3139
    },
    "JP-O29": {
      "id": "JP-O29",
      "language": "ja",
      "text": "私たちは関係者でしたっけ？",
      "scene": "고베 / Tunnel Archive 08",
      "src": "/audio/echo/ja/JP-O29.mp3",
      "durationMs": 2755
    },
    "JP-O30": {
      "id": "JP-O30",
      "language": "ja",
      "text": "ええと……私は案内係なんですけど。",
      "scene": "고베 / Tunnel Archive 08",
      "src": "/audio/echo/ja/JP-O30.mp3",
      "durationMs": 4026
    },
    "JP-O31": {
      "id": "JP-O31",
      "language": "ja",
      "text": "入構証は持っていません！ほほ。",
      "scene": "고베 / Tunnel Archive 08",
      "src": "/audio/echo/ja/JP-O31.mp3",
      "durationMs": 3829
    },
    "JP-O32": {
      "id": "JP-O32",
      "language": "ja",
      "text": "土砂を運んでいた場所が、今度はデータのための施設になるそうです。",
      "scene": "고베 / Tunnel Archive 09",
      "src": "/audio/echo/ja/JP-O32.mp3",
      "durationMs": 5498
    },
    "JP-O33": {
      "id": "JP-O33",
      "language": "ja",
      "text": "このトンネルは、第二の人生を準備しているんですね！",
      "scene": "고베 / Tunnel Archive 09",
      "src": "/audio/echo/ja/JP-O33.mp3",
      "durationMs": 5031
    },
    "JP-O34": {
      "id": "JP-O34",
      "language": "ja",
      "text": "あなたもいつか、また来てみませんか？",
      "scene": "고베 / Tunnel Archive 09",
      "src": "/audio/echo/ja/JP-O34.mp3",
      "durationMs": 3457
    },
    "JP-T01": {
      "id": "JP-T01",
      "language": "ja",
      "text": "ちょっと中に入ってみますね。",
      "scene": "고베 / Inner Tunnel",
      "src": "/audio/echo/ja/JP-T01.mp3",
      "durationMs": 2420
    },
    "JP-T02": {
      "id": "JP-T02",
      "language": "ja",
      "text": "私が見たものは……",
      "scene": "고베 / Inner Tunnel",
      "src": "/audio/echo/ja/JP-T02.mp3",
      "durationMs": 1480
    },
    "JP-T03": {
      "id": "JP-T03",
      "language": "ja",
      "text": "何もありません。",
      "scene": "고베 / Inner Tunnel",
      "src": "/audio/echo/ja/JP-T03.mp3",
      "durationMs": 1320
    },
    "JP-T04": {
      "id": "JP-T04",
      "language": "ja",
      "text": "空っぽですね。",
      "scene": "고베 / Inner Tunnel",
      "src": "/audio/echo/ja/JP-T04.mp3",
      "durationMs": 1110
    },
    "JP-T05": {
      "id": "JP-T05",
      "language": "ja",
      "text": "まるで、何かが入ってくるのを待っているみたいです。",
      "scene": "고베 / Inner Tunnel",
      "src": "/audio/echo/ja/JP-T05.mp3",
      "durationMs": 4039
    }
  }
}
